@{ ViewData["Title"] = "Log workspace"; }
<div class="app-shell">
    <header class="topbar"><div class="brand-mark"><span class="brand-dot"></span><span>MyLog</span><small>FIELD CONSOLE</small></div><div class="pathbar"><span class="eyebrow">LOCATION</span><input id="current-path" aria-label="Current path" placeholder="Enter an allowed folder path" /><button id="go-button" class="text-button" title="Go to location">Go</button></div><div class="top-actions"><button id="refresh-button" class="icon-button" title="Refresh file list">&#8635;</button><button id="theme-button" class="icon-button" title="Toggle dark mode">&#9681;</button></div></header>
    <section class="workspace"><aside class="sidebar"><div class="section-heading"><span id="reset-root" style="cursor: pointer; color: var(--ink); font-weight: bold;" title="Return to Root">ROOTS</span><span id="root-count">0</span></div><div id="folder-tree" class="folder-tree"></div><div class="sidebar-note">Configured folders are enforced by the server.</div></aside><section class="file-panel"><div class="panel-heading"><div><span class="eyebrow">DIRECTORY</span><h1>File browser</h1></div><div class="file-tools"><label class="search"><span>&#8981;</span><input id="search-input" placeholder="Find a file" /></label><label class="filter"><input id="logs-only" type="checkbox" /> .log only</label></div></div><div class="table-wrap"><table><thead><tr><th data-sort="name">NAME <span class="sort-mark"></span></th><th data-sort="size">SIZE</th><th data-sort="modified">LAST MODIFIED</th><th>TYPE</th><th></th></tr></thead><tbody id="file-list"></tbody></table><div id="empty-state" class="empty-state">Choose a folder to inspect its files.</div></div></section></section>
    <section class="viewer-panel"><div class="viewer-heading"><div><span class="eyebrow">LIVE OUTPUT</span><h2 id="viewer-title">No file open</h2><div style="margin-top:5px;"><input id="custom-highlight" placeholder="Custom highlight (e.g. ID1, thread-2)" style="width:250px; padding:3px 6px; background:transparent; border:1px solid #496660; color:var(--code); font:11px monospace;" /></div></div><div class="viewer-actions" style="flex-wrap: wrap; justify-content: flex-end;"><span id="connection-status" class="status-pill">OFFLINE</span><button id="pause-button" class="text-button" disabled>Pause</button><button id="clear-button" class="text-button">Clear</button><button id="copy-button" class="text-button" title="Copy visible logs to clipboard">Copy</button><button id="format-json-button" class="text-button" title="Format inline JSON">Format JSON</button><div style="display:inline-flex; border:1px solid #496660;"><button id="font-dec" class="text-button" style="border:0;" title="Decrease font size">A-</button><button id="font-inc" class="text-button" style="border:0; border-left:1px solid #496660;" title="Increase font size">A+</button></div><label class="auto-scroll"><input id="errors-only" type="checkbox" /> Errors/Warns only</label><label class="auto-scroll"><input id="show-lines" type="checkbox" checked /> Line numbers</label><label class="auto-scroll"><input id="word-wrap" type="checkbox" checked /> Word wrap</label><label class="auto-scroll"><input id="auto-scroll" type="checkbox" checked /> Auto-scroll</label></div></div><div class="content-search"><input id="content-search" placeholder="Search file content" aria-label="Search file content" /><select id="search-mode" aria-label="Search mode"><option value="text">Normal text</option><option value="regex">Regular expression</option></select><select id="search-context" aria-label="Search context"><option value="0">No context</option><option value="2">±2 lines</option><option value="5">±5 lines</option><option value="10">±10 lines</option></select><button id="search-button" class="text-button">Search</button><button id="export-search-button" class="text-button" style="display: none;" title="Download search results">Export</button><span id="search-summary" class="search-summary"></span></div><pre id="log-viewer" class="log-viewer show-lines"><code>Open a file to read it, or tail a log to watch new lines arrive.</code></pre></section>
</div>
