@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="page-panel">
    <span class="eyebrow">Something went wrong</span>
    <h1>An error occurred while processing your request.</h1>

    @if (Model.ShowRequestId)
    {
        <p class="file-meta"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    <p>
        Try returning to the <a href="@Url.Action("Index", "Home")">log workspace</a>.
        If this keeps happening, check the application logs for the request ID above.
    </p>
</div>
