@{ ViewData["Title"] = "Log workspace"; }
<div class="app-shell">
    <header class="topbar">
        <div class="brand-mark">
            <span class="brand-dot" aria-hidden="true"></span>
            <span>MyLog</span>
            <small>FIELD CONSOLE</small>
        </div>
        <div class="pathbar">
            <label class="eyebrow" for="current-path">Location</label>
            <input id="current-path" placeholder="Enter an allowed folder path" />
            <button id="go-button" class="text-button" title="Go to location">Go</button>
        </div>
        <div class="top-actions">
            <button id="toggle-sidebar" class="icon-button" aria-label="Toggle sidebar" aria-expanded="true" aria-controls="sidebar" title="Toggle sidebar">&#9776;</button>
            <button id="refresh-button" class="icon-button" aria-label="Refresh file list" title="Refresh file list">&#8635;</button>
            <button id="theme-button" class="icon-button" aria-label="Toggle dark mode" aria-pressed="false" title="Toggle dark mode">&#9681;</button>
        </div>
    </header>

    <div class="main-content">
        <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>
        <aside class="sidebar" id="sidebar" aria-label="Allowed folders">
            <div class="section-heading">
                <button type="button" id="reset-root" class="root-reset" title="Return to the root folder">ROOTS</button>
                <span id="root-count" aria-label="Root folder count">0</span>
            </div>
            <div id="folder-tree" class="folder-tree"></div>
            <p class="sidebar-note">Configured folders are enforced by the server.</p>
        </aside>

        <div class="editor-area">
            <section class="file-panel" id="file-panel">
                <div class="panel-heading">
                    <div>
                        <span class="eyebrow">Directory</span>
                        <h1>File browser</h1>
                    </div>
                    <div class="file-tools">
                        <label class="search">
                            <span aria-hidden="true">&#8981;</span>
                            <input id="search-input" placeholder="Find a file" aria-label="Filter files by name" />
                        </label>
                        <label class="filter"><input id="logs-only" type="checkbox" /> .log only</label>
                    </div>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th data-sort="name" scope="col" aria-sort="ascending">NAME <span class="sort-mark"></span></th>
                                <th data-sort="size" scope="col" aria-sort="none">SIZE <span class="sort-mark"></span></th>
                                <th data-sort="modified" scope="col" aria-sort="none">LAST MODIFIED <span class="sort-mark"></span></th>
                                <th scope="col">TYPE</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody id="file-list"></tbody>
                    </table>
                    <div id="empty-state" class="empty-state">Choose a folder to inspect its files.</div>
                </div>
            </section>

            <section class="viewer-panel" id="viewer-panel" hidden>
                <div id="loading-overlay" class="loading-overlay hidden" role="status" aria-live="polite">
                    <div class="spinner" aria-hidden="true"></div>
                    <div id="loading-text" class="loading-text">LOADING...</div>
                </div>
                <div class="viewer-heading">
                    <div>
                        <span class="eyebrow">Live output</span>
                        <h2 id="viewer-title">No file open</h2>
                        <div class="custom-highlight-wrap">
                            <input id="custom-highlight" placeholder="Custom highlight (e.g. ID1, thread-2)" aria-label="Custom highlight keywords, comma separated" />
                        </div>
                    </div>
                    <div class="viewer-actions">
                        <span id="connection-status" class="status-pill" role="status">OFFLINE</span>
                        <button id="close-file-button" class="text-button" title="Close file and return to browser">Close File</button>
                        <button id="pause-button" class="text-button" disabled>Pause</button>
                        <button id="clear-button" class="text-button">Clear</button>
                        <button id="copy-button" class="text-button" title="Copy visible logs to clipboard">Copy</button>
                        <button id="format-json-button" class="text-button" title="Format inline JSON">Format JSON</button>
                        <div class="font-size-group">
                            <button id="font-dec" class="text-button" aria-label="Decrease log font size" title="Decrease font size">A-</button>
                            <button id="font-inc" class="text-button" aria-label="Increase log font size" title="Increase font size">A+</button>
                        </div>
                        <button id="options-toggle" class="text-button options-toggle" aria-expanded="false" aria-controls="viewer-toggles">Options</button>
                        <div class="viewer-toggles" id="viewer-toggles">
                            <div class="sheet-header">
                                <span>View options</span>
                                <button type="button" id="options-close" class="text-button">Done</button>
                            </div>
                            <label class="auto-scroll"><input id="errors-only" type="checkbox" /> Errors/Warns only</label>
                            <label class="auto-scroll"><input id="show-lines" type="checkbox" checked /> Line numbers</label>
                            <label class="auto-scroll"><input id="auto-format-json" type="checkbox" /> Auto-Format JSON</label>
                            <label class="auto-scroll"><input id="word-wrap" type="checkbox" checked /> Word wrap</label>
                            <label class="auto-scroll"><input id="auto-scroll" type="checkbox" checked /> Auto-scroll</label>
                        </div>
                    </div>
                </div>
                <div class="content-search">
                    <input id="content-search" placeholder="Search file content" aria-label="Search file content" />
                    <select id="search-mode" aria-label="Search mode">
                        <option value="text">Normal text</option>
                        <option value="regex">Regular expression</option>
                    </select>
                    <select id="search-context" aria-label="Search context">
                        <option value="0">No context</option>
                        <option value="2">&#177;2 lines</option>
                        <option value="5">&#177;5 lines</option>
                        <option value="10">&#177;10 lines</option>
                    </select>
                    <button id="search-button" class="text-button">Search</button>
                    <button id="export-search-button" class="text-button" title="Download search results" hidden>Export</button>
                    <span id="search-summary" class="search-summary" role="status" aria-live="polite"></span>
                </div>
                <pre id="log-viewer" class="log-viewer show-lines" tabindex="0" aria-label="Log content">Open a file to read it, or tail a log to watch new lines arrive.</pre>
            </section>
        </div>
    </div>
</div>
