{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedFolders": [
        "D:\\WSProjectLogs", "C:\\WSProjectLogs",
        "Logs",
        "C:\\Logs\\Downloads",
        "\\\\192.168.1.230\\d$\\WSProjectLogs",
        "\\\\192.168.1.10\\d$\\WSProjectLogs",
        "\\\\192.168.1.11\\d$\\WSProjectLogs",
        "C:\\Logs\\MyLog"
    ],
    "RemoteLogApi": {
        "UseUatEnvironment": false,
        "SitBaseUrl": "https://gateway-sit.example.com/",
        "SitApiKey": "YOUR_SIT_API_KEY",
        "UatBaseUrl": "https://gateway-uat.example.com/",
        "UatApiKey": "YOUR_UAT_API_KEY",
        "ListProjectsPath": "api/al/retail/v1/ListProjectNameLogInquiry",
        "ListFilesPath": "api/al/retail/v1/ListFileNameLogInquiry",
        "BrowseFilePath": "api/al/retail/v1/BrowseFileLogByName",
        "Cookie": "",
        "TimeoutSeconds": 120,
        "MaxZipSizeMB": 100,
        "MaxExtractedSizeMB": 300
    },
    "Clusters": [
        {
            "ClusterId": "service-cluster-01",
            "ClusterName": "Core Service Cluster (Load Balancer)",
            "Description": "Load Balanced App Nodes (192.168.1.10 / 192.168.1.11)",
            "Nodes": [
                {
                    "NodeId": "node-01",
                    "NodeName": "Node 1 (192.168.1.10)",
                    "Path": "\\\\192.168.1.10\\d$\\WSProjectLogs",
                    "ApiUrl": "https://192.168.1.10/UAT/mylog",
                    "HostHeader": "cluster.example.local"
                },
                {
                    "NodeId": "node-02",
                    "NodeName": "Node 2 (192.168.1.11)",
                    "Path": "\\\\192.168.1.11\\d$\\WSProjectLogs",
                    "ApiUrl": "https://192.168.1.11/UAT/mylog",
                    "HostHeader": "cluster.example.local"
                }
            ]
        }
    ],
    "AllowedHosts": "*"
}
